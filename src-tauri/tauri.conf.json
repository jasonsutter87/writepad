{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WRITEpad",
  "version": "0.1.5",
  "identifier": "com.jasonsutter.writepad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WRITEpad",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "../demo/": "demo/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0NEFBN0U4NDk4MDY4REMKUldUY2FJQko2S2RLMU44YmVSbmdYTGQ0TXNhZnkxOWJMQkpibi9QazUrTTNIK0JnRHhKUEtxVnIK",
      "endpoints": [
        "https://github.com/jasonsutter87/writepad/releases/latest/download/latest.json"
      ]
    }
  }
}
